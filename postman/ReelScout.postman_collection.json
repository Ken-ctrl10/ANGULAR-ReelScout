    },
    {
      "name": "Security and performance",
      "item": [
        {
          "name": "11. CORS - Angular app is allowed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies/popular",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "popular"
              ]
            },
            "description": "Checks that the API allows requests from the Angular app (localhost:4200)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Allows the Angular origin', () => {",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(pm.collectionVariables.get('frontendOrigin'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "12. CORS - other websites are blocked",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://evil.example.com"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies/popular",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "popular"
              ]
            },
            "description": "Checks that the API does not allow other websites. Postman ignores CORS, so this checks the header a browser would enforce."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No allow header for unknown origin', () => {",
                  "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.not.eql('http://evil.example.com');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "13. Security - TMDB token is never exposed",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies/27205",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "27205"
              ]
            },
            "description": "Checks that no response contains the TMDB token. The token stays on the server."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Response does not contain a bearer token', () => {",
                  "    const body = pm.response.text();",
                  "    pm.expect(body).to.not.match(/eyJ[A-Za-z0-9_-]{20,}\\./);",
                  "    pm.expect(body.toLowerCase()).to.not.include('bearer');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "14. Performance - cached response is fast",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/movies/popular",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "movies",
                "popular"
              ]
            },
            "description": "Calls popular movies again. Laravel serves it from cache instead of calling TMDB, so it should be under 1 second."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Served quickly from cache (under 1s)', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth and favorites",
      "item": [
        {
          "name": "15. Register a new user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Creates an account and returns a Sanctum token. A unique test email/password is generated on each run.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"password_confirmation\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique test account for this run",
                  "const id = Date.now();",
                  "pm.collectionVariables.set('testEmail', 'tester' + id + '@example.test');",
                  "pm.collectionVariables.set('testPassword', 'Test-' + id + '-pass');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 (created)', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Returns user and token', () => {",
                  "    pm.expect(json.user.email).to.eql(pm.collectionVariables.get('testEmail'));",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.test('Password is never returned', () => pm.expect(json.user).to.not.have.property('password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "16. Register with an email already used - expect 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "The same email can't register twice.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"password_confirmation\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "pm.test('Error on email', () => pm.expect(pm.response.json().errors).to.have.property('email'));"
                ]
              }
            }
          ]
        },
        {
          "name": "17. Register with mismatched passwords - expect 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "password and password_confirmation must match.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mismatch\",\n  \"email\": \"mismatch{{$timestamp}}@example.test\",\n  \"password\": \"{{testPassword}}\",\n  \"password_confirmation\": \"something-else\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "pm.test('Error on password', () => pm.expect(pm.response.json().errors).to.have.property('password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "18. Login with a wrong password - expect 422",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Wrong credentials are rejected with one generic message (doesn't reveal whether the email exists).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"wrong-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "pm.test('Generic message', () => pm.expect(pm.response.json().errors.email[0]).to.eql('The email or password is incorrect.'));"
                ]
              }
            }
          ]
        },
        {
          "name": "19. Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Logs in and returns a new token, which the following requests use.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Returns a token', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "20. Get the logged-in user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user"
              ]
            },
            "description": "Returns who the token belongs to."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Correct user', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('testEmail')));"
                ]
              }
            }
          ]
        },
        {
          "name": "21. Get favorites without a token - expect 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/favorites",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "favorites"
